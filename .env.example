# ==============================================================================
# AEROCRASH - CONFIGURATION DE PRODUCTION (.env)
# ==============================================================================

# 1. BASE DE DONNÉES CLOUD - NEON (PostgreSQL Serverless)
# Créez votre projet gratuit sur https://console.neon.tech
# IMPORTANT : Pour les déploiements serverless (Netlify, Vercel), utilisez l'URL avec "-pooler"
DATABASE_URL="postgresql://neondb_owner:votre_mot_de_passe@ep-votre-projet-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# (Optionnel) URL directe sans connection pooler (pour scripts d'administration ou migrations)
DIRECT_URL="postgresql://neondb_owner:votre_mot_de_passe@ep-votre-projet.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. PASSERELLE DE PAIEMENT - SASPAY (Mobile Money & Cartes)
# Tableau de bord : https://app.saspay.me
# Fournie par SasPay pour les tests ou la production
SASPAY_API_KEY="votre_cle_api_saspay_ici"

# Secret de signature Webhook (fourni par SasPay lors de la création du webhook)
# Permet de vérifier cryptographiquement (HMAC SHA-256) les notifications de paiement
SASPAY_WEBHOOK_SECRET="votre_secret_webhook_saspay_ici"

# URL de l'API SasPay (valeur par défaut officielle)
SASPAY_API_URL="https://api.saspay.me/api/v1"

# 3. URL PUBLIQUE DE L'APPLICATION
# Utilisée par SasPay pour rediriger le client après paiement (return_url)
# En local : http://localhost:3000 | En production : https://votre-domaine.com
APP_URL="http://localhost:3000"

# 4. SÉCURITÉ & AUTHENTIFICATION (JWT)
# Clé secrète robuste pour chiffrer les sessions des utilisateurs (générez une chaîne aléatoire de 64 caractères)
JWT_SECRET="remplacez_par_une_cle_secrete_aleatoire_tres_longue_en_production"

# 5. EMAILS TRANSACTIONNELS - RESEND (Codes OTP, factures & bordereaux)
# Créez une clé API sur https://resend.com/api-keys et vérifiez votre domaine expéditeur.
RESEND_API_KEY="re_votre_cle_api_resend_ici"
RESEND_FROM_EMAIL="contact@votre-domaine.com"
RESEND_FROM_NAME="AeroCrash"

# 6. RÈGLES FINANCIÈRES STRICTES (PRODUCTION)
MIN_DEPOSIT_FCFA="1000"
MIN_WITHDRAW_FCFA="2000"
PLATFORM_FEE_PERCENT="0.025"

# 7. CONFIGURATION OPTIONNELLE
# Si le backend Express est hébergé séparément (ex: Render, Railway, VPS)
VITE_API_URL=""

# Clé API Google Gemini (si utilisation de l'IA pour l'analyse ou le chat)
GEMINI_API_KEY=""
